#include <windows.h>

/* RT_MANIFEST 的 id 必须是 1，Windows 才会在进程启动时应用它 */
1 RT_MANIFEST "app.manifest"

/* 程序图标（exe 图标 + 任务栏/标题栏），构建时从 app.ico 嵌入。 */
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "local"
            VALUE "FileDescription",  "Codex / Claude Code status monitor (C++ build)"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "win_agent_notify_c"
            VALUE "OriginalFilename", "win_agent-notify-C.exe"
            VALUE "ProductName",      "win_agent-notify-C"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
